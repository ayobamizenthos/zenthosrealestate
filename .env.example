# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — used for notification fan-out. Never expose.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Cloudinary (Dashboard → Settings → Upload) -----------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
# Must be an *unsigned* upload preset so the admin browser can upload directly.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=zenthos_unsigned

# --- Site -------------------------------------------------------------------
# Drives canonical URLs, sitemap entries and Open Graph tags. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://zenthosrealestate.com.ng

# --- Web Push (generate with: npx web-push generate-vapid-keys) -------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:hello@zenthosrealestate.com.ng
